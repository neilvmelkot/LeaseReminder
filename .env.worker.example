# =============================================================================
# Worker overrides. Copy to .env.worker.
#
# The worker loads .env first and then this file, so anything here wins.
#
# It exists for one reason: both services read Database:ConnectionString, and
# they must connect as different roles. app_worker holds no table privileges
# at all -- it reaches everything through SECURITY DEFINER functions -- which
# is only true if the worker actually connects as app_worker.
#
# Generated for you by:
#   ./db/set-role-passwords.sh url "<owner conninfo>"
# =============================================================================

Database__ConnectionString=Host=REPLACE_ME.pooler.supabase.com;Port=5432;Database=postgres;Username=app_worker.REPLACE_ME;Password=REPLACE_ME;SSL Mode=VerifyFull
