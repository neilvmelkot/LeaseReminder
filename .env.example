# =============================================================================
# LeaseReminder — backend configuration. PLACEHOLDERS ONLY.
#
# Copy to .env for local development. NEVER commit a real .env.
# Production values belong in the Render dashboard.
#
# Every key here is one the code actually reads. .NET maps a double underscore
# onto a nested configuration key, so Storage__Supabase__Bucket is
# Storage:Supabase:Bucket in appsettings terms.
#
# The FRONTEND is configured separately, in frontend/.env.local — its
# NEXT_PUBLIC_* values are compiled into the browser bundle and deliberately
# do not live here.
#
# Full walkthrough: docs/setup.md
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- Database ----------------------------------------------------------------
# The API connects as app_api: least privilege, Row Level Security ENFORCED,
# never the table owner and never a superuser.
#
# The WORKER uses a different role and reads the same key, so its value lives
# in .env.worker, which ./backend/build.sh run-worker loads second.
#
# Generate both with:
#   ./db/set-role-passwords.sh url "<owner conninfo>"
# It prints them ready to paste. You never type a role password.
#
# Semicolon key/value, not a URI, so nothing here needs percent-encoding.
# Through the Supabase pooler the username carries the project reference:
# app_api.<project-ref>, not app_api.
Database__ConnectionString=Host=REPLACE_ME.pooler.supabase.com;Port=5432;Database=postgres;Username=app_api.REPLACE_ME;Password=REPLACE_ME;SSL Mode=VerifyFull

# --- Authentication ----------------------------------------------------------
# Tokens are verified against Supabase's published signing keys. You configure
# only the issuer: the keys are fetched from its OIDC metadata and refreshed
# automatically, so a rotation at Supabase needs no change here.
Jwt__Issuer=https://REPLACE_ME.supabase.co/auth/v1
Jwt__Audience=authenticated

# --- CORS --------------------------------------------------------------------
# A strict allowlist. A wildcard is refused at startup, because a wildcard
# alongside credentials is the one configuration that makes every other
# control here pointless.
Cors__AllowedOrigins__0=http://localhost:3000

# --- Document storage --------------------------------------------------------
# Read by the API, to store an upload and mint short-lived signed URLs, and by
# the worker, to fetch a document for reading.
#
# The service-role key bypasses Row Level Security entirely. It stays on the
# server and is never prefixed NEXT_PUBLIC_.
Storage__Supabase__ProjectUrl=https://REPLACE_ME.supabase.co
Storage__Supabase__ServiceRoleKey=REPLACE_ME_SERVICE_ROLE_KEY
Storage__Supabase__Bucket=lease-documents
# A signed URL is a bearer credential for one object, so its value decays fast.
Storage__Supabase__SignedUrlLifetimeSeconds=300

# --- Document extraction -----------------------------------------------------
# A Google AI Studio key: https://aistudio.google.com/apikey
# Needed by the WORKER. The API never calls the model.
#
# Leave it blank and extraction is simply switched off: documents still upload
# and store, and their terms are entered by hand. That is a supported state,
# not a broken one.
Documents__Gemini__ApiKey=REPLACE_ME_GOOGLE_AI_KEY
# Configurable because free-tier model availability changes over time.
Documents__Gemini__Model=gemini-2.5-flash

# --- Google OAuth, for connecting a Gmail mailbox ----------------------------
# Use SEPARATE OAuth clients for development and production: two minutes of
# work, and a leaked development secret then cannot send from the real account.
#
# The API needs all four — it runs the consent flow. The worker needs the id
# and secret, because it exchanges the refresh token before every send.
#
# RedirectUri must match one registered on the OAuth client EXACTLY. Google
# compares it as a string; a mismatch gives redirect_uri_mismatch.
Google__ClientId=REPLACE_ME.apps.googleusercontent.com
Google__ClientSecret=REPLACE_ME_CLIENT_SECRET
Google__RedirectUri=http://localhost:8080/api/v1/integrations/google/callback
# Where the browser lands after consent. The FRONTEND, not the API.
Google__CompletionUrl=http://localhost:3000/settings/email
# Sending only, plus the address of the account that consented.
#
# openid and email reveal WHICH Google account was connected and nothing
# else -- no access to mail. Without them the address cannot be read at all
# (Gmail's profile endpoint needs a READ scope), and the mailbox shows as
# connected under a placeholder address.
Google__Scope=openid email https://www.googleapis.com/auth/gmail.send

# --- Token encryption --------------------------------------------------------
# Protects the stored Gmail refresh token with AES-256-GCM. Needed by BOTH the
# API (which encrypts on connect) and the worker (which decrypts to send), and
# the value must be identical in both.
#
# Format: version:base64key, comma separated. Several may be listed at once,
# which is what makes rotation possible without downtime — the current version
# encrypts, every listed key can decrypt.
#
# 32 raw bytes, base64. Generate with:
#   openssl rand -base64 32
#
# Keep it OUT of the database: a database backup should not be a working set of
# Gmail credentials. Losing it means reconnecting the mailbox, nothing else.
TokenEncryption__Keys=1:REPLACE_ME_BASE64_32_BYTES
TokenEncryption__CurrentKeyVersion=1

# =============================================================================
# Operators only — never read by a running service
# =============================================================================

# The table owner, for migrations. A URI, so a password containing / @ % : must
# be percent-encoded — or pass keyword/value form to the scripts instead and
# avoid the question entirely.
MIGRATION_DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@REPLACE_ME.pooler.supabase.com:5432/postgres
