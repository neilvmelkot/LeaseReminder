<Project>

  <!--
    Central package version management. Every version is declared once here,
    so a security update is a one-line change and two projects can never
    disagree about which version of a parser they are using.

    Versions are PINNED exactly rather than floating. Central package
    management rejects floating versions unless explicitly enabled, and the
    reason it does is worth keeping: a floating patch means two machines can
    build different binaries from the same commit. Updates are a reviewed
    edit to this file, surfaced by the dotnet list package outdated check in CI.

    NuGetAuditMode=all in Directory.Build.props fails the build on a known
    vulnerability in a direct OR transitive dependency. That check is what
    caught HtmlSanitizer 9.0 pulling a vulnerable AngleSharp; see the note on
    that entry below.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning lets a PackageVersion entry here override a version
      chosen by a dependency, which is how a vulnerable transitive package is
      forced up without waiting for its parent to release.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Date and time">
    <!--
      NodaTime rather than DateTime/TimeZoneInfo. The specification requires
      correct handling of ambiguous and nonexistent local times at daylight
      saving transitions (sections 7 and 9). NodaTime makes those cases
      explicit in the type system: resolving a LocalDateTime in a DateTimeZone
      forces a decision about which instant was meant, where TimeZoneInfo
      quietly picks one for you.
    -->
    <PackageVersion Include="NodaTime" Version="3.2.5" />
    <PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.3.1" />

    <!--
      NodaTime plugins, so Instant and LocalDate map to timestamptz and date
      natively. Without them the domain would have to use DateTime at the
      storage boundary, which reintroduces exactly the ambiguity NodaTime was
      chosen to remove.
    -->
    <PackageVersion Include="Npgsql.NodaTime" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Web and hosting">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Extensions primitives">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Validation and logging">
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup Label="Phase 2: document intelligence">
    <!--
      Both are document parsers reading untrusted input, so section 4.C
      applies directly: keep them current, and run them in the worker rather
      than in the API process, where a malformed file would occupy a request
      thread and share a blast radius with every other caller.
    -->
    <PackageVersion Include="PdfPig" Version="0.1.11" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup Label="Phase 4: Gmail (declared, not yet referenced)">
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.69.0.3669" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.69.0" />

    <!--
      Rich-text sanitisation for the phase 4 template editor. Declared but
      deliberately NOT referenced yet: nothing in phase 1 accepts author-
      supplied HTML, and the 9.0 line resolves a transitively vulnerable
      AngleSharp (GHSA-pgww-w46g-26qg) that the NuGet audit rejects.

      Escaping a template VARIABLE is a different job and needs no library:
      TemplateRenderer uses System.Text.Encodings.Web.HtmlEncoder. Sanitising
      is only required once a user can author markup of their own, and this
      entry must be re-checked against the advisory database at that point.
    -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Lets an integration test skip, with a reason, when no database is reachable. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

</Project>
