{
  "Database": {
    "ConnectionString": "",
    "AllowInsecureTransport": false,
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "authenticated",
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "MaxJsonBodyBytes": 65536,
    "MaxUploadBytes": 52428800,
    "EnableHsts": true,
    "HstsMaxAgeSeconds": 31536000
  },
  "TokenEncryption": {
    "Keys": "",
    "CurrentKeyVersion": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
